# Copy to .env for local development. Do not commit real credentials.
POSTGRES_DB=afdd
POSTGRES_USER=afdd
POSTGRES_PASSWORD=afdd-local-only
DATABASE_URL=postgresql+psycopg://afdd:afdd-local-only@db:5432/afdd

REDPANDA_BROKERS=redpanda:9092
TELEMETRY_TOPIC=telemetry.raw.v1
AFDD_EVALUATION_TOPIC=telemetry.accepted.v1
CONSUMER_GROUP_INGESTION=afdd-ingestion-v1
CONSUMER_GROUP_WORKER=afdd-worker-v1

SIMULATOR_SOURCE_DIR=/app/data/candidate-starter-pack/sample-telemetry
SEED_SOURCE_DIR=/app/data/candidate-starter-pack/building-and-equipment
SIMULATOR_INTERVAL_SECONDS=60
SIMULATOR_ACCELERATION_FACTOR=60

API_HOST=0.0.0.0
API_PORT=8000
VITE_API_BASE_URL=http://localhost:8000

# Optional: required only for the manual AI authoring demo. Never commit a real key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
